# KoboldCPP — ROCm (hipBLAS) build for the AMD Halo box: Radeon 8060S, gfx1151.
# Selected by LLM_BACKEND=rocm in ai-stack/host.env (lib/host.sh), tagged
# localhost/koboldcpp:rocm. The alternative is Containerfile.vulkan; HALO_PLAN.md Phase B
# benchmarks the two and picks the default.
#
# Upstream ships no Linux ROCm binary (the YellowRoseCx fork publishes Windows builds only),
# so this compiles mainline KoboldCPP at the same tag as the CUDA image, using its own
# Makefile target: `make koboldcpp_hipblas LLAMA_HIPBLAS=1`. GPU_TARGETS limits the HIP
# kernels to the one GPU we have; the Makefile's default list is a dozen architectures
# and roughly as many times the compile.
#
# The ROCm userspace lives in the image; the host only needs the amdgpu kernel driver and
# /dev/kfd + /dev/dri. ROCM_IMAGE is a build argument so the Phase B benchmark can try the
# ROCm the Rex host ships (10.x) against the 7.14 the gfx1151 community tracks.
ARG KOBOLDCPP_VERSION=1.111.2
ARG ROCM_IMAGE=docker.io/rocm/dev-ubuntu-24.04:7.14.1-full
ARG GPU_TARGETS=gfx1151

FROM ${ROCM_IMAGE} AS build
ARG KOBOLDCPP_VERSION
ARG GPU_TARGETS
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends git make \
    && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch "v${KOBOLDCPP_VERSION}" \
        https://github.com/LostRuins/koboldcpp.git /src
WORKDIR /src
RUN make koboldcpp_hipblas LLAMA_HIPBLAS=1 GPU_TARGETS="${GPU_TARGETS}" -j"$(nproc)" \
    && test -f koboldcpp_hipblas.so \
    && find . -name '*.o' -delete && rm -rf .git

FROM ${ROCM_IMAGE}
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends curl python3 \
    && rm -rf /var/lib/apt/lists/*
# koboldcpp.py is the launcher; it loads koboldcpp_hipblas.so when given --usecublas and
# no CUDA library is present, which is how lib/host.sh's flag reaches the ROCm path.
COPY --from=build /src /opt/koboldcpp

VOLUME /models
EXPOSE 5001

# Same probe as the CUDA image; see the notes there (docker format only, long start period).
HEALTHCHECK --interval=30s --timeout=10s --start-period=300s --retries=5 \
    CMD curl -fs http://localhost:5001/api/v1/model || exit 1

ENTRYPOINT ["python3", "/opt/koboldcpp/koboldcpp.py"]
# No --usemmap: mmap is off by default in this KoboldCPP, and on Strix Halo it is reported
# to be catastrophic for ROCm loads past half of memory.
CMD ["--host", "127.0.0.1", "--port", "5001", "--usecublas", "--gpulayers", "-1"]
