# KoboldCPP — CUDA build for NVIDIA GPUs
# Change KOBOLDCPP_VERSION to match a tag from:
# https://github.com/LostRuins/koboldcpp/releases
ARG KOBOLDCPP_VERSION=1.111.2

FROM docker.io/nvidia/cuda:12.4.1-runtime-ubuntu22.04 AS base

ARG KOBOLDCPP_VERSION

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Download the pre-built Linux binary (CUDA bundled since v1.x)
RUN curl -fsSL \
    "https://github.com/LostRuins/koboldcpp/releases/download/v${KOBOLDCPP_VERSION}/koboldcpp-linux-x64" \
    -o /usr/local/bin/koboldcpp \
    && chmod +x /usr/local/bin/koboldcpp

VOLUME /models
EXPOSE 5001

# HEALTHCHECK is a docker-format field with no OCI slot, so podman drops it unless the build
# passes --format docker (start.sh and `stack install koboldcpp` both do). Without that flag
# this block is silently inert.
#
# The long start period is the point of the whole block: this loads a multi-GB GGUF into VRAM
# before the port answers at all, and a cold read off disk is far slower than a warm one.
# Failures inside the start period don't count against the container, so an honest ceiling
# here is what keeps a slow load from reporting unhealthy instead of starting.
#
# retries=5, not the usual 3, because KoboldCPP answers the API on the same listener that
# serves generation: a long completion can leave this probe waiting, and five intervals
# (~2.5 min) outlasts one. /api/v1/model is what `stack status` already probes.
HEALTHCHECK --interval=30s --timeout=10s --start-period=300s --retries=5 \
    CMD curl -fs http://localhost:5001/api/v1/model || exit 1

ENTRYPOINT ["/usr/local/bin/koboldcpp"]
# Pass extra flags after "--" when using start.sh, or override CMD entirely.
# --usecublas enables CUDA; --gpulayers -1 offloads all layers to GPU.
CMD ["--host", "127.0.0.1", "--port", "5001", "--usecublas", "--gpulayers", "-1"]
