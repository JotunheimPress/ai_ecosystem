# Copy to host.env (git-ignored) to override what lib/host.sh detects. Parsed, never sourced.
# Without host.env: NVIDIA (CUDA) if nvidia-ctk has a CDI spec, else AMD if /dev/kfd exists.
#
# The AMD Halo box (HALO_PLAN.md):
GPU=amd
# vulkan or rocm for KoboldCPP; ComfyUI always uses ROCm on AMD.
# Pick the default from the Phase B benchmark.
LLM_BACKEND=vulkan
# Every port is published on all interfaces, so the workstation and any device on the LAN
# reach the box directly. Set an IPv4 address here to publish on that one only.
#BIND=127.0.0.1
# Host port for ComfyUI. Where the OS already runs its own ComfyUI on 127.0.0.1:8188, the stack's moves
# here. Other containers still reach it as comfyui:8188 on ai-net.
COMFYUI_PORT=8189
