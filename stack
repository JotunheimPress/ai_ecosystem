#!/usr/bin/env bash
# ============================================================
# ai-stack — one launcher for the local AI backends + frontends.
#
#   stack                 interactive: ensure backends, then pick a frontend
#   stack on / off        ENABLE / DISABLE the AI backend — the single switch.
#                           off = stop backends + no boot restart (free the GPU to game)
#                           on  = start backends now + at boot
#   stack up              start the backends now (without touching the boot toggle)
#   stack status          show what's up
#   stack <app>           start one app        (companion|story|iguana|koboldcpp|comfyui)
#   stack down [target]   stop  all|backends|frontends|<app>   (default: all)
#   stack restart <app>
#   stack logs <app>
#   stack install [target]  one-time setup: build backend images, create the network,
#                           install the systemd unit, link onto PATH. Idempotent.
#                           all|backends|koboldcpp|comfyui|service|path  (default: all)
#   stack doctor          check prerequisites + what's installed, change nothing
#
# Backends are shared; frontends run side-by-side on their own ports.
# Add a new frontend = one row in the registry below.
# ============================================================
set -uo pipefail

# Where the AI projects live. Override with AI_ECOSYSTEM; otherwise derive it from
# this script's own location (readlink -f resolves the ~/.local/bin/stack symlink),
# i.e. the directory holding the ai-stack checkout. Nothing is hardcoded, so the
# stack works wherever the projects are cloned as siblings.
SELF="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"   # the ai-stack checkout itself
ECO="${AI_ECOSYSTEM:-$(dirname "$SELF")}"
NET="ai-net"
SVC="ai-stack-backends.service"     # systemd --user unit = the single on/off switch for boot

BACKENDS=(koboldcpp comfyui)
FRONTENDS=(companion story iguana)

declare -A PORT HEALTH DESC KIND CNAME
#           port  health-url                              description                              kind       container-name
reg() { local k=$1; PORT[$k]=$2; HEALTH[$k]=$3; DESC[$k]=$4; KIND[$k]=$5; CNAME[$k]=${6:-}; }
reg koboldcpp 5001 "http://localhost:5001/api/v1/model"  "LLM text generation (KoboldCPP)"          container koboldcpp
reg comfyui   8188 "http://localhost:8188/system_stats"  "Image/video generation (ComfyUI)"          container comfyui
reg companion 7861 "http://localhost:7861/"              "Character-card AI companion"               container companion
reg story     7860 "http://localhost:7860/"              "AI Story Maker"                            container ai-story-maker
reg iguana    7862 "http://localhost:7862/"              "iguana_studio ComfyUI GUI"                 container iguana

C_GREEN=$'\e[32m'; C_RED=$'\e[31m'; C_DIM=$'\e[2m'; C_OFF=$'\e[0m'; C_B=$'\e[1m'

ensure_net() { podman network exists "$NET" 2>/dev/null || { echo "==> creating network $NET"; podman network create "$NET" >/dev/null; }; }

is_up() { curl -sf --max-time 3 -o /dev/null "${HEALTH[$1]}" 2>/dev/null; }

# PID currently listening on a host port ("" if free). Used by the `proc` kind — no
# app uses it today (ComfyUI, the last one, is now a container), but the branch is
# kept as the extension point for a future host-side app.
port_pid() { ss -tlnHp 2>/dev/null | grep -F ":$1" | grep -oP 'pid=\K[0-9]+' | head -1; }

wait_up() { local a=$1 n=${2:-60} i; for ((i=0;i<n;i++)); do is_up "$a" && return 0; sleep 2; done; return 1; }

start_app() {
  case "$1" in
    koboldcpp) "$ECO/koboldcpp/start.sh" >/dev/null 2>&1 ;;
    companion) "$ECO/companion/run-podman.sh" >/dev/null 2>&1 ;;
    story)     "$ECO/ai_story_maker/run-podman.sh" >/dev/null 2>&1 ;;
    # Canonical recipe lives in the ai-stack checkout, not in the upstream ComfyUI
    # tree (our files would be untracked there). Code is in the image; the checkout
    # supplies only mutable state via --base-directory.
    comfyui)   "$SELF/comfyui/start.sh" >/dev/null 2>&1 ;;
    iguana)    "$ECO/iguana_studio/comfyui-auto/run-podman.sh" >/dev/null 2>&1 ;;
  esac
}

stop_app() {
  case "${KIND[$1]}" in
    container) podman stop "${CNAME[$1]}" >/dev/null 2>&1 ;;
    proc)
      # These processes are visible in the host PID namespace (they listen on host
      # ports), so stop them by their listening port — robust, no pkill self-match.
      local p; p=$(port_pid "${PORT[$1]}")
      [ -n "${p:-}" ] && kill "$p" 2>/dev/null ;;
  esac
  return 0
}

dot() { is_up "$1" && printf "%bup  %b" "$C_GREEN" "$C_OFF" || printf "%bdown%b" "$C_RED" "$C_OFF"; }

row() { printf "  %-11s [%b]  %b:%s%b  %b%s%b\n" "$1" "$(dot "$1")" "$C_DIM" "${PORT[$1]}" "$C_OFF" "$C_DIM" "${DESC[$1]}" "$C_OFF"; }

cmd_status() {
  if have_svc; then
    if svc_enabled; then echo "AI backend switch: ${C_GREEN}ON${C_OFF}  (auto-starts at boot)"
    else                 echo "AI backend switch: ${C_RED}OFF${C_OFF} (gaming mode — won't start at boot)"; fi
  fi
  echo "${C_B}Backends${C_OFF} (network: $NET)"; for a in "${BACKENDS[@]}"; do row "$a"; done
  echo "${C_B}Frontends${C_OFF}";               for a in "${FRONTENDS[@]}"; do row "$a"; done
}

start_one() {
  local a=$1
  if is_up "$a"; then echo "  $a already up (:${PORT[$a]})"; return 0; fi
  # Health says down, but for a `proc` app the port may still be held — by an instance
  # that's mid-startup, or wedged. Starting now would just lose the port race, and the
  # loser's exit says nothing about the process actually serving the port. Report the
  # holder instead of launching a doomed second copy.
  if [[ "${KIND[$a]}" == proc ]]; then
    local held; held=$(port_pid "${PORT[$a]}")
    if [[ -n "$held" ]]; then
      echo "  ${C_RED}✗${C_OFF} $a: pid $held already holds :${PORT[$a]} but isn't answering health yet."
      echo "    ${C_DIM}still loading? re-run in a moment. wedged? stack down $a && stack $a${C_OFF}"
      echo "    ${C_DIM}logs: stack logs $a${C_OFF}"
      return 1
    fi
  fi
  echo "==> starting $a …"; start_app "$a"
  if wait_up "$a" "$([[ $a == koboldcpp ]] && echo 60 || echo 30)"; then
    local note=""
    [[ "${KIND[$a]}" == proc ]] && note=" ${C_DIM}(pid $(port_pid "${PORT[$a]}"))${C_OFF}"
    echo "  ${C_GREEN}✓${C_OFF} $a up at http://localhost:${PORT[$a]}$note"
  else
    echo "  ${C_RED}✗${C_OFF} $a did not come up — check: stack logs $a"
    [[ "${KIND[$a]}" == container ]] && podman logs --tail 3 "${CNAME[$a]}" 2>&1 | sed "s/^/    ${C_DIM}/;s/\$/${C_OFF}/"
    return 1
  fi
}

cmd_up() { ensure_net; for a in "${BACKENDS[@]}"; do start_one "$a"; done; }

cmd_down() {
  local t=${1:-all} list=()
  case "$t" in
    all)       list=("${FRONTENDS[@]}" "${BACKENDS[@]}") ;;
    backends)  list=("${BACKENDS[@]}") ;;
    frontends) list=("${FRONTENDS[@]}") ;;
    *)         [[ -n "${KIND[$t]:-}" ]] && list=("$t") || { echo "unknown target: $t"; return 1; } ;;
  esac
  for a in "${list[@]}"; do echo "==> stopping $a"; stop_app "$a"; done
}

have_svc()     { systemctl --user list-unit-files "$SVC" >/dev/null 2>&1; }
svc_enabled()  { systemctl --user is-enabled "$SVC" 2>/dev/null | grep -qx enabled; }

cmd_on() {
  ensure_net
  if have_svc; then
    systemctl --user enable --now "$SVC" >/dev/null 2>&1
    echo "${C_GREEN}AI backend ON${C_OFF} — running + will start at boot."
  else
    echo "(systemd unit not installed — starting backends without boot toggle)"; cmd_up
  fi
}

cmd_off() {
  if have_svc; then
    # disable --now: stop the service (ExecStop = 'stack down backends') AND remove boot start.
    systemctl --user disable --now "$SVC" >/dev/null 2>&1
  fi
  cmd_down backends >/dev/null 2>&1   # belt-and-suspenders: ensure they're really down
  echo "${C_RED}AI backend OFF${C_OFF} — stopped and will NOT restart at boot. GPU free to game."
  echo "  re-enable with: stack on"
}

cmd_menu() {
  echo "${C_B}ai-stack${C_OFF}"; echo
  cmd_status; echo
  # ensure backends
  local need=()
  for a in "${BACKENDS[@]}"; do is_up "$a" || need+=("$a"); done
  if ((${#need[@]})); then
    read -rp "Start backends (${need[*]})? [Y/n] " ans
    [[ "${ans:-Y}" =~ ^[Nn] ]] || { ensure_net; for a in "${need[@]}"; do start_one "$a"; done; echo; }
  fi
  # pick a frontend
  echo "Pick a frontend to launch:"
  local i=1; for a in "${FRONTENDS[@]}"; do printf "  %d) %-10s %s\n" "$i" "$a" "${DESC[$a]}"; ((i++)); done
  printf "  0) done\n"
  read -rp "> " sel
  [[ "$sel" =~ ^[0-9]+$ ]] || { echo "cancelled"; return; }
  ((sel==0)) && return
  local pick="${FRONTENDS[$((sel-1))]:-}"
  [[ -n "$pick" ]] && start_one "$pick" || echo "invalid choice"
}

cmd_logs() {
  local a=${1:?usage: stack logs <app>}
  podman logs -f "${CNAME[$a]:-$a}"
}

# ---------- install ------------------------------------------------------------
# Executable form of koboldcpp/INSTALL.md + comfyui/INSTALL.md, so the docs and the
# real thing can't drift. Everything here is idempotent: re-running reports what is
# already in place and does nothing. Model weights are never downloaded — they're
# third-party and ~73 GB; install only tells you what's missing.

IMG_KOBOLD="localhost/koboldcpp:latest"
IMG_COMFY="localhost/comfyui:latest"

# ComfyUI custom nodes the frontends depend on. Cloned into the bind-mounted
# custom_nodes/ state dir, pinned to a commit so a rebuild can't silently pull in
# upstream changes.
#
# IMPORTANT: a node's Python dependencies do NOT belong here. custom_nodes/ is
# state, but the container is recreated on every start, so runtime pip installs
# evaporate. Deps go in comfyui/Containerfile — adding a row here usually means
# adding a line there too. Weights are never downloaded (see the note in
# cmd_install); missing ones are reported, not fetched.
#
#            name|repo|pinned commit
CUSTOM_NODES=(
  "ComfyUI-PhotoMaker-Plus|https://github.com/shiimizu/ComfyUI-PhotoMaker-Plus.git|459f5c009e8bc3fe76bd63a7f302ddf3406c7062"
  "ComfyUI-GGUF|https://github.com/city96/ComfyUI-GGUF.git|6ea2651e7df66d7585f6ffee804b20e92fb38b8a"
)

WARNS=0
ok()   { echo "  ${C_GREEN}✓${C_OFF} $*"; }
warn() { WARNS=$((WARNS+1)); echo "  ${C_RED}!${C_OFF} $*"; }
step() { echo "==> $*"; }

check_prereqs() {
  local bad=0
  command -v podman >/dev/null 2>&1 && ok "podman $(podman --version | awk '{print $3}')" \
    || { warn "podman not found — required"; bad=1; }
  if nvidia-smi >/dev/null 2>&1; then
    ok "nvidia driver: $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader | head -1)"
  else
    warn "nvidia-smi failed on the host — GPU passthrough will not work"; bad=1
  fi
  if nvidia-ctk cdi list 2>/dev/null | grep -q "nvidia.com/gpu=all"; then
    ok "CDI device nvidia.com/gpu=all present"
  else
    warn "no CDI spec — run: sudo nvidia-ctk cdi generate --output=/etc/cdi/nvidia.yaml"; bad=1
  fi
  return $bad
}

install_path() {
  local target="$HOME/.local/bin/stack" src; src="$(readlink -f "${BASH_SOURCE[0]}")"
  if [ -e "$target" ] && [ "$(readlink -f "$target")" = "$src" ]; then
    ok "on PATH at $target"
  else
    step "linking $target -> $src"
    mkdir -p "$HOME/.local/bin" && ln -sfn "$src" "$target" && ok "linked"
    case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) warn "$HOME/.local/bin is not on your PATH" ;; esac
  fi
}

install_service() {
  local dst="$HOME/.config/systemd/user/$SVC"
  # COPY, never symlink: `systemctl disable` deletes a symlinked unit, which then
  # breaks `stack on`.
  if [ -f "$dst" ] && cmp -s "$SELF/$SVC" "$dst"; then
    ok "systemd unit installed ($dst)"
  else
    step "installing systemd unit -> $dst"
    mkdir -p "$(dirname "$dst")" && cp -f "$SELF/$SVC" "$dst" && systemctl --user daemon-reload && ok "installed"
  fi
  [ "$(loginctl show-user "$USER" -p Linger --value 2>/dev/null)" = "yes" ] \
    && ok "linger enabled (backends can start before login)" \
    || warn "linger off — run: loginctl enable-linger"
  svc_enabled && ok "boot auto-start armed (stack on)" || echo "  ${C_DIM}boot auto-start off — arm with: stack on${C_OFF}"
}

install_koboldcpp() {
  step "koboldcpp"
  if podman image exists "$IMG_KOBOLD"; then
    ok "image $IMG_KOBOLD built"
  else
    echo "  building (pulls the CUDA base + KoboldCPP binary; a few minutes)…"
    podman build -t "$IMG_KOBOLD" "$ECO/koboldcpp" || { warn "build failed"; return 1; }
    ok "image built"
  fi
  local models="$ECO/koboldcpp/models" n=0
  mkdir -p "$models"
  n=$(find "$models" -maxdepth 1 -name '*.gguf' 2>/dev/null | wc -l)
  ((n)) && ok "$n GGUF model(s) in $models" \
        || warn "no *.gguf in $models — see ai-stack/koboldcpp/INSTALL.md §2"
}

install_custom_nodes() {
  local state=$1 row name url pin dir have
  ((${#CUSTOM_NODES[@]})) || return 0
  if ! command -v git >/dev/null 2>&1; then
    warn "git not found — cannot install custom nodes"; return 0
  fi
  for row in "${CUSTOM_NODES[@]}"; do
    IFS='|' read -r name url pin <<<"$row"
    dir="$state/custom_nodes/$name"
    if [ -d "$dir/.git" ]; then
      have=$(git -C "$dir" rev-parse HEAD 2>/dev/null)
      if [ "$have" = "$pin" ]; then
        ok "custom node $name @ ${pin:0:7}"
      else
        step "custom node $name: ${have:0:7} -> ${pin:0:7}"
        # Not --depth 1 anywhere in here: a shallow clone only carries the tip, so
        # checking out an older pin would fail the moment upstream moves on.
        git -C "$dir" fetch --quiet origin 2>/dev/null
        if git -C "$dir" checkout --quiet "$pin" 2>/dev/null; then
          ok "custom node $name @ ${pin:0:7}"
        else
          warn "custom node $name: commit $pin not found in $dir"
        fi
      fi
    elif [ -e "$dir" ]; then
      warn "custom node $name exists but isn't a git checkout — left alone ($dir)"
    else
      step "cloning custom node $name"
      if git clone --quiet "$url" "$dir" 2>/dev/null \
         && git -C "$dir" checkout --quiet "$pin" 2>/dev/null; then
        ok "custom node $name @ ${pin:0:7}"
      else
        warn "custom node $name: clone failed — $url"
      fi
    fi
  done
}

install_comfyui() {
  step "comfyui"
  if podman image exists "$IMG_COMFY"; then
    ok "image $IMG_COMFY built"
  else
    echo "  building (torch + CUDA wheels, ~6.9 GB; several minutes)…"
    podman build -t "$IMG_COMFY" "$SELF/comfyui" || { warn "build failed"; return 1; }
    ok "image built"
  fi
  # Code ships in the image; the host tree only holds state. Create the skeleton so a
  # fresh install can start before any models are downloaded.
  local state="${COMFYUI_STATE:-$ECO/ComfyUI}" d
  for d in models/checkpoints input output user custom_nodes; do mkdir -p "$state/$d"; done
  ok "state dirs ready under $state"
  local n; n=$(find "$state/models/checkpoints" -maxdepth 1 -type f \
                    \( -name '*.safetensors' -o -name '*.ckpt' \) 2>/dev/null | wc -l)
  ((n)) && ok "$n checkpoint(s) in $state/models/checkpoints" \
        || warn "no checkpoints — see ai-stack/comfyui/INSTALL.md §8 (start with absolutereality_v181)"

  install_custom_nodes "$state"

  # PhotoMaker-Plus is inert without its weights, and weights are out of scope —
  # so say what's missing rather than pretending the node is ready to use.
  if [ -d "$state/custom_nodes/ComfyUI-PhotoMaker-Plus" ]; then
    n=$(find "$state/models/photomaker" -maxdepth 1 -name '*.bin' 2>/dev/null | wc -l)
    ((n)) && ok "$n PhotoMaker model(s) in $state/models/photomaker" \
          || warn "no PhotoMaker weights — put photomaker-v{1,2}.bin in $state/models/photomaker"
    # insightface resolves buffalo_l as <root>/models/<name>, hence the doubled path.
    [ -f "$state/models/insightface/models/buffalo_l/det_10g.onnx" ] \
      && ok "InsightFace buffalo_l present" \
      || warn "no InsightFace buffalo_l — needs the 5 .onnx files in $state/models/insightface/models/buffalo_l/ (PhotoMaker V2 only)"
  fi
}

cmd_install() {
  local t=${1:-all} rc=0
  case "$t" in all|backends|koboldcpp|comfyui|service|path) ;;
    *) echo "unknown install target: $t (all|backends|koboldcpp|comfyui|service|path)"; return 1 ;;
  esac
  echo "${C_B}ai-stack install${C_OFF} — target: $t   ${C_DIM}(idempotent; weights are never downloaded)${C_OFF}"
  echo "${C_B}Prerequisites${C_OFF}"; check_prereqs || rc=1
  [[ "$t" == all || "$t" == path ]]    && { echo "${C_B}PATH${C_OFF}";    install_path; }
  [[ "$t" == all || "$t" == service ]] && { echo "${C_B}systemd${C_OFF}"; install_service; }
  if [[ "$t" == all || "$t" == backends || "$t" == koboldcpp || "$t" == comfyui ]]; then
    echo "${C_B}Backends${C_OFF}"; ensure_net
    [[ "$t" == comfyui   ]] || install_koboldcpp || rc=1
    [[ "$t" == koboldcpp ]] || install_comfyui   || rc=1
  fi
  echo
  # Missing weights are not an install failure — they're deliberately out of scope —
  # but "complete" would be a lie when nothing can actually start. Say which it is.
  if ((rc)); then
    echo "${C_RED}install failed${C_OFF} — unmet prerequisites above"
  elif ((WARNS)); then
    echo "${C_RED}install done, $WARNS item(s) need you${C_OFF} — the stack won't start until they're resolved"
  else
    echo "${C_GREEN}install complete${C_OFF} — start with: stack on"
  fi
  ((rc)) && return 1 || return 0
}

cmd_doctor() {
  echo "${C_B}Prerequisites${C_OFF}"; check_prereqs
  echo "${C_B}Installed${C_OFF}"
  podman image exists "$IMG_KOBOLD" && ok "$IMG_KOBOLD" || warn "$IMG_KOBOLD missing — stack install koboldcpp"
  podman image exists "$IMG_COMFY"  && ok "$IMG_COMFY"  || warn "$IMG_COMFY missing — stack install comfyui"
  podman network exists "$NET" 2>/dev/null && ok "network $NET" || warn "network $NET missing — stack install"
  [ -f "$HOME/.config/systemd/user/$SVC" ] && ok "systemd unit $SVC" || warn "$SVC not installed — stack install service"
  local state="${COMFYUI_STATE:-$ECO/ComfyUI}" row name pin dir
  for row in "${CUSTOM_NODES[@]}"; do
    IFS='|' read -r name _ pin <<<"$row"
    dir="$state/custom_nodes/$name"
    if [ ! -d "$dir/.git" ]; then
      warn "custom node $name missing — stack install comfyui"
    elif [ "$(git -C "$dir" rev-parse HEAD 2>/dev/null)" = "$pin" ]; then
      ok "custom node $name @ ${pin:0:7}"
    else
      warn "custom node $name off its pin (${pin:0:7}) — stack install comfyui"
    fi
  done
  echo "${C_B}Runtime${C_OFF}"; cmd_status
}

case "${1:-}" in
  ""|menu)   cmd_menu ;;
  on|enable)  cmd_on ;;
  off|disable|gaming) cmd_off ;;
  up|backends) cmd_up ;;
  status|st) cmd_status ;;
  down)      cmd_down "${2:-all}" ;;
  restart)   a=${2:?usage: stack restart <app>}; stop_app "$a"; sleep 1; ensure_net; start_one "$a" ;;
  logs)      cmd_logs "${2:-}" ;;
  install|setup) cmd_install "${2:-all}" ;;
  doctor|check)  cmd_doctor ;;
  -h|--help|help) sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//' ;;
  *)         a=$1; [[ -n "${KIND[$a]:-}" ]] || { echo "unknown app: $a (try: stack status)"; exit 1; }
             [[ " ${FRONTENDS[*]} " == *" $a "* ]] && ensure_net
             start_one "$a" ;;
esac
