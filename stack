#!/usr/bin/env bash
# ============================================================
# ai-stack — one launcher for the local AI backends + frontends.
#
#   stack                 interactive: ensure backends, then pick a frontend
#   stack on / off        ENABLE / DISABLE the AI backend — the single switch.
#                           off = stop backends + no boot restart (free the GPU to game)
#                           on  = start backends now + at boot
#   stack up              start the backends now (without touching the boot toggle)
#   stack status [--json] show what's up (--json: for stack-ui and scripts)
#   stack <app>           start one app: a backend (router|koboldcpp|comfyui|fortuna),
#                           stackui, or an installed frontend by its repo name (stack frontends)
#   stack frontends [--json]  list the installed frontends (each repo's frontend.json)
#   stack down [target]   stop  all|backends|frontends|<app>   (default: all)
#   stack restart <app>
#   stack logs <app>
#   stack route [local|halo]  show / set where text is served (backend router)
#   stack install [target]  one-time setup: build backend images, create the network,
#                           install the systemd unit, link onto PATH. Idempotent.
#                           all|backends|router|koboldcpp|comfyui|fortuna|stackui|service|path
#   stack doctor          check prerequisites + what's installed, change nothing
#
# Backends are shared; frontends run side-by-side on their own ports.
# Frontends aren't listed here: any sibling repo with a frontend.json is one (see
# frontend_manifests below). Install a frontend = clone it next to ai-stack.
# ============================================================
set -uo pipefail

# Where the AI projects live. Override with AI_ECOSYSTEM; otherwise derive it from
# this script's own location (readlink -f resolves the ~/.local/bin/stack symlink),
# i.e. the directory holding the ai-stack checkout. Nothing is hardcoded, so the
# stack works wherever the projects are cloned as siblings.
SELF="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"   # the ai-stack checkout itself
ECO="${AI_ECOSYSTEM:-$(dirname "$SELF")}"
NET="ai-net"
SVC="ai-stack-backends.service"     # systemd --user unit = the single on/off switch for boot
# Host profile: NVIDIA workstation or AMD Halo box (lib/host.sh, host.env). A bad host.env
# is reported, not fatal, so `stack doctor` can still run and say what's wrong.
. "$SELF/lib/host.sh"
host_profile_load || HOST_PROFILE_BAD=1

# router first: every backend is health-probed THROUGH it, so without it they read as down
# and `stack up` would reload models that were already serving.
BACKENDS=(router koboldcpp comfyui fortuna)
FRONTENDS=()   # filled from the installed repos' frontend.json by load_frontends
# Control apps are shown and startable like the rest, but deliberately excluded from
# `down all` / `down frontends`: stack-ui is the thing you're clicking in, and having a
# button stop its own server is a bad afternoon. Stop it explicitly (`stack down stackui`).
CONTROL=(stackui)

declare -A PORT HEALTH DESC KIND CNAME
#           port  health-url                              description                              kind       container-name
reg() { local k=$1; PORT[$k]=$2; HEALTH[$k]=$3; DESC[$k]=$4; KIND[$k]=$5; CNAME[$k]=${6:-}; }
# The router owns the names `koboldcpp`, `comfyui` and `fortuna` on ai-net and their host
# ports; this machine's copies run as `*-local` behind it, with no host ports (router/,
# HALO_PLAN.md). Health URLs go through the router: they report what frontends get.
reg router    5001 "http://localhost:5001/__router/health" "Routes every capability to where it runs" container backend-router
reg koboldcpp 5001 "http://localhost:5001/api/v1/model"  "LLM text generation (KoboldCPP)"          container koboldcpp-local
reg comfyui   "$HOST_COMFY_PORT" "http://localhost:$HOST_COMFY_PORT/system_stats" "Image, video and audio generation (ComfyUI)" container comfyui-local
# Typed decisions (/v1/systemone): JevK5 on llama.cpp. Up = model loaded (fortuna/CLAUDE.md).
# The router publishes it on loopback only; frontends use http://fortuna:8009 on ai-net.
reg fortuna   8009 "http://127.0.0.1:8009/health"        "Typed decisions: yes/no, choice, score (JevK5)" container fortuna-local
# Containerized like everything else, but with the host podman socket and session bus
# mounted so it can drive them. Loopback-only by design (see stack-ui/CLAUDE.md).
reg stackui   7863 "http://127.0.0.1:7863/api/health"    "Control dashboard for the stack itself"    container stackui

# Facing names. The key on the left is what you type (`stack koboldcpp`) and what every
# target check matches — this is only what a UI puts on the card, so a product rename never
# touches a command anyone has in their fingers. Apps whose product name is already their
# key need no row. stack-ui reads this out of the script the same way it reads CUSTOM_NODES:
# one registry, so the dashboard cannot disagree with the CLI about what a thing is called.
# Frontends are not in this block: their facing name is the `brand` in their own
# frontend.json (load_frontends adds it here at run time, and stack-ui reads it from
# `stack frontends --json`).
declare -A LABEL=(
  [router]="Router"
  [koboldcpp]="Oracle"
  [comfyui]="Morpheus"
  [fortuna]="Fortuna"
  [stackui]="AI Ecosystem"
)

# What each backend provides. stack-ui groups its Infrastructure view by this, and
# `status --json` carries it, so a new backend is a row here rather than a name check in
# the UI. Only backends have one.
declare -A CAP=(
  [router]=routing
  [koboldcpp]=text
  [comfyui]=image-sound
  [fortuna]=decision
)

# How to ask THIS machine's copy of a backend whether it is up, bypassing the router: run
# inside its own container with `podman exec … sh -c`. Every routed backend has a row: its
# served address goes through the router, and for text can be another machine (`stack route
# halo`). Not podman's health field: it is unreliable for koboldcpp-local, which reads
# "starting" for days. ComfyUI's image has python3 but no curl.
declare -A LOCAL_PROBE=(
  [koboldcpp]="curl -sf -m 3 -o /dev/null http://127.0.0.1:5001/api/v1/model"
  [comfyui]="python3 -c 'import urllib.request as u; u.urlopen(\"http://127.0.0.1:8188/system_stats\", timeout=3)'"
  [fortuna]="curl -sf -m 3 -o /dev/null http://127.0.0.1:8009/health"
)

# ---- frontends: discovered, not registered ---------------------------------------------
# A frontend is any repo directly under $ECO with a frontend.json at its root. So the list
# is exactly what's installed, and a fork (npc_maker next to companion) shows up as itself
# instead of hiding behind a hardcoded name. The manifest:
#
#   { "repo": "companion",                       identity: what you type, unique, = repo name
#     "brand": "companion",                      what a UI shows (default: repo)
#     "description": "Character-card AI companion",
#     "port": 7861,                              host port it serves on
#     "health": "http://127.0.0.1:7861/api/health",   200 = up; must be on localhost
#     "container": "companion",                  podman name: stop + logs
#     "start": "run-podman.sh",                  path inside the repo, executable
#     "icon": "mdi-account-heart-outline",       optional, for stack-ui
#     "https_port": 7868,                        optional: the same app over HTTPS (needed
#                                                  for the microphone from another device)
#     "https_setup": "/ca" }                     optional: path on the HTTP port that explains
#                                                  trusting its certificate
#
# Parsed with python3 (it's in the stack-ui image too; jq isn't). Bad manifests are
# skipped and reported by `stack doctor`, never fatal: one broken clone mustn't take the
# whole launcher down. Names a command or a built-in app already uses are refused, since
# `stack <name>` would never reach them.
FRONTEND_RESERVED=("${BACKENDS[@]}" "${CONTROL[@]}" all backends frontends
  menu on enable off disable gaming up status st down restart logs route install setup
  doctor check help)

# mode: tsv (records for load_frontends) | json (stack-ui) — both from the same checks.
frontend_manifests() {
  python3 - "$1" "$ECO" "${FRONTEND_RESERVED[@]}" <<'PY'
import json, os, re, sys
from pathlib import Path

mode, eco, reserved = sys.argv[1], Path(sys.argv[2]), set(sys.argv[3:])
NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$")
ICON = re.compile(r"^mdi-[a-z0-9-]+$")
URLPATH = re.compile(r"^/[A-Za-z0-9._~/-]{0,127}$")
HEALTH = re.compile(r"^https?://(localhost|127\.0\.0\.1)(:\d+)?(/\S*)?$")
CTRL = re.compile(r"[\x00-\x1f\x7f]")
US = "\x1f"   # field separator: tabs would collapse empty fields under bash `read`

def text(v, field, limit=200):
    if not isinstance(v, str) or CTRL.search(v) or len(v) > limit:
        raise ValueError(f"{field} must be a single-line string")
    return v

def origin_repo(d):
    """Repo name from .git/config's origin url, or None. Read, not `git`: cheap and no git needed."""
    try:
        cfg = (d / ".git" / "config").read_text()
    except OSError:
        return None
    m = re.search(r'\[remote "origin"\][^\[]*?url\s*=\s*(\S+)', cfg)
    return re.sub(r"\.git$", "", m.group(1).rstrip("/").rsplit("/", 1)[-1].rsplit(":", 1)[-1]) if m else None

apps, warns, seen = [], [], {}
for d in sorted(p for p in eco.iterdir() if p.is_dir() and not p.name.startswith(".")):
    mf = d / "frontend.json"
    if not mf.is_file():
        continue
    try:
        m = json.loads(mf.read_text())
        if not isinstance(m, dict):
            raise ValueError("not a JSON object")
        repo = m.get("repo")
        if not isinstance(repo, str) or not NAME.match(repo):
            raise ValueError("repo must be a name (letters, digits, _ . -)")
        if repo in reserved:
            raise ValueError(f"repo {repo!r} clashes with a stack command or built-in app")
        port = m.get("port")
        if not isinstance(port, int) or isinstance(port, bool) or not 1024 <= port <= 65535:
            raise ValueError("port must be an integer 1024-65535")
        health = text(m.get("health"), "health")
        if not HEALTH.match(health):
            raise ValueError("health must be an http URL on localhost or 127.0.0.1")
        container = m.get("container")
        if not isinstance(container, str) or not NAME.match(container):
            raise ValueError("container must be a podman name")
        start = text(m.get("start"), "start")
        sp = (d / start).resolve()
        if os.path.isabs(start) or d.resolve() not in sp.parents:
            raise ValueError("start must be a path inside the repo")
        if not (sp.is_file() and os.access(sp, os.X_OK)):
            raise ValueError(f"start script {start} missing or not executable")
        brand = text(m.get("brand") or repo, "brand", 64)
        desc = text(m.get("description", ""), "description")
        icon = m.get("icon") or ""
        if icon and not (isinstance(icon, str) and ICON.match(icon)):
            raise ValueError("icon must look like mdi-name")
        https_port = m.get("https_port")
        if https_port is not None and (not isinstance(https_port, int) or isinstance(https_port, bool)
                                       or not 1024 <= https_port <= 65535 or https_port == port):
            raise ValueError("https_port must be an integer 1024-65535, not the same as port")
        https_setup = m.get("https_setup") or ""
        if https_setup and not (isinstance(https_setup, str) and URLPATH.match(https_setup)):
            raise ValueError("https_setup must be a path like /ca")
    except (OSError, ValueError) as e:
        warns.append(f"{d.name}/frontend.json skipped: {e}")
        continue
    if repo in seen:
        warns.append(f"{d.name}/frontend.json skipped: repo {repo!r} is already {seen[repo]}/ — "
                     f"a fork needs its own repo name")
        continue
    seen[repo] = d.name
    o = origin_repo(d)
    if o and o != repo:
        warns.append(f"{d.name}/frontend.json says repo {repo!r} but its origin is {o!r}")
    for other in apps:
        for what, mine, theirs in (("port", port, other["port"]),
                                   ("container name", container, other["container"])):
            if mine == theirs:
                warns.append(f"{repo} and {other['repo']} share {what} {mine} — "
                             f"they can't run at the same time")
    apps.append(dict(repo=repo, brand=brand, description=desc, port=port, health=health,
                     container=container, start=str(sp), dir=str(d), icon=icon,
                     https_port=https_port, https_setup=https_setup))

if mode == "json":
    print(json.dumps({"frontends": [{k: a[k] for k in ("repo", "brand", "description", "port", "icon", "dir",
                                                       "https_port", "https_setup")}
                                    for a in apps], "warnings": warns}))
else:
    for a in apps:
        # description last: it is the only free-text field.
        print(US.join(["F", a["repo"], a["brand"], str(a["port"]), a["health"], a["container"],
                       a["start"], a["dir"], a["icon"], str(a["https_port"] or ""), a["https_setup"],
                       a["description"]]))
    for w in warns:
        print(US.join(["W", w]))
PY
}

declare -A FSTART FDIR FICON FHTTPS FHTTPS_SETUP
FRONTEND_WARN=()
load_frontends() {
  if ! command -v python3 >/dev/null 2>&1; then
    FRONTEND_WARN+=("python3 not found — can't read frontend.json, so no frontends are listed")
    return 0
  fi
  local kind repo brand port health cname start dir icon https setup desc
  while IFS=$'\x1f' read -r kind repo brand port health cname start dir icon https setup desc; do
    case $kind in
      F) reg "$repo" "$port" "$health" "$desc" container "$cname"
         LABEL[$repo]=$brand; FSTART[$repo]=$start; FDIR[$repo]=$dir; FICON[$repo]=$icon
         FHTTPS[$repo]=$https; FHTTPS_SETUP[$repo]=$setup
         FRONTENDS+=("$repo") ;;
      W) FRONTEND_WARN+=("$repo") ;;
    esac
  done < <(frontend_manifests tsv)
}
load_frontends

cmd_frontends() {
  if [[ ${1:-} == --json ]]; then frontend_manifests json; return; fi
  if ((${#FRONTENDS[@]} == 0)); then echo "no frontends installed (no */frontend.json in $ECO)"; fi
  local a
  for a in "${FRONTENDS[@]}"; do
    printf "  %-18s %-20s :%-5s %b%s%b\n" "$a" "${LABEL[$a]}" "${PORT[$a]}" "$C_DIM" "${FDIR[$a]}" "$C_OFF"
  done
  for a in "${FRONTEND_WARN[@]}"; do echo "  ${C_RED}!${C_OFF} $a"; done
}

C_GREEN=$'\e[32m'; C_RED=$'\e[31m'; C_DIM=$'\e[2m'; C_OFF=$'\e[0m'; C_B=$'\e[1m'

ensure_net() { podman network exists "$NET" 2>/dev/null || { echo "==> creating network $NET"; podman network create "$NET" >/dev/null; }; }

is_up() { curl -sf --max-time 3 -o /dev/null "${HEALTH[$1]}" 2>/dev/null; }

# PID currently listening on a host port ("" if free). Used by the `proc` kind — no
# app uses it today (ComfyUI, the last one, is now a container), but the branch is
# kept as the extension point for a future host-side app.
port_pid() { ss -tlnHp 2>/dev/null | grep -F ":$1" | grep -oP 'pid=\K[0-9]+' | head -1; }

wait_up() { local a=$1 n=${2:-60} i; for ((i=0;i<n;i++)); do ready "$a" && return 0; sleep 2; done; return 1; }

# Is what the router serves for this app THIS machine's copy? Only text can be routed
# elsewhere (`stack route halo`); everything else is always served locally.
route_is_local() { [[ "$(route_now)" == koboldcpp-local:* ]]; }
serves_local()   { [[ $1 != koboldcpp ]] || route_is_local; }

# This machine's copy of a backend, bypassing the router:
#   absent (no container) | stopped | loading (running, not answering yet) | up
local_state() {
  local a=$1 c=${CNAME[$1]} st
  st=$(podman inspect -f '{{.State.Status}}' "$c" 2>/dev/null) || { echo absent; return; }
  [[ $st == running ]] || { echo stopped; return; }
  if [[ -n ${LOCAL_PROBE[$a]:-} ]]; then
    podman exec "$c" sh -c "${LOCAL_PROBE[$a]}" >/dev/null 2>&1 && echo up || echo loading
  else
    is_up "$a" && echo up || echo loading
  fi
}

# "Up" for starting and waiting: the local copy whenever the served address isn't it, so
# `stack koboldcpp` while text is routed to Halo loads and waits for THIS copy instead of
# reporting the Halo box as already up.
ready() { if serves_local "$1"; then is_up "$1"; else [[ $(local_state "$1") == up ]]; fi; }

# Health of many apps at once, into UP[app]=1/0. In parallel: one sequential pass is
# 3 s per app that's down, and stack-ui polls this every few seconds.
declare -A UP
probe_all() {
  local a tmp; tmp=$(mktemp -d) || return 1
  for a in "$@"; do ( is_up "$a" && : > "$tmp/$a" ) & done
  wait
  for a in "$@"; do [[ -e "$tmp/$a" ]] && UP[$a]=1 || UP[$a]=0; done
  rm -rf "$tmp"
}

start_app() {
  case "$1" in
    # stderr stays visible: start.sh reports a layer fallback or a load failure there,
    # and `stack restart` is what the dashboard streams.
    router)    "$SELF/router/start.sh" >/dev/null ;;
    koboldcpp) "$ECO/koboldcpp/start.sh" >/dev/null ;;
    # Canonical recipe lives in the ai-stack checkout, not in the upstream ComfyUI
    # tree (our files would be untracked there). Code is in the image; the checkout
    # supplies only mutable state via --base-directory.
    comfyui)   "$SELF/comfyui/start.sh" >/dev/null ;;
    # Returns once the model is loaded; stderr says what's missing (e.g. the GGUF).
    fortuna)   "$SELF/fortuna/start.sh" >/dev/null ;;
    # Ships in this checkout, like the comfyui recipe — hence $SELF, not $ECO.
    stackui)   "$SELF/stack-ui/run-podman.sh" >/dev/null 2>&1 ;;
    # Frontends: the start script their frontend.json names (checked to be inside the repo).
    *)         [[ -n "${FSTART[$1]:-}" ]] && "${FSTART[$1]}" >/dev/null 2>&1 ;;
  esac
}

stop_app() {
  case "${KIND[$1]}" in
    container) podman stop "${CNAME[$1]}" >/dev/null 2>&1 ;;
    proc)
      # These processes are visible in the host PID namespace (they listen on host
      # ports), so stop them by their listening port — robust, no pkill self-match.
      local p; p=$(port_pid "${PORT[$1]}")
      [ -n "${p:-}" ] && kill "$p" 2>/dev/null ;;
  esac
  return 0
}

dot() {
  local u=${UP[$1]:-}
  [[ -n $u ]] || { is_up "$1" && u=1 || u=0; }
  ((u)) && printf "%bup  %b" "$C_GREEN" "$C_OFF" || printf "%bdown%b" "$C_RED" "$C_OFF"
}

row() { printf "  %-16s [%b]  %b:%s%b  %b%s%b\n" "$1" "$(dot "$1")" "$C_DIM" "${PORT[$1]}" "$C_OFF" "$C_DIM" "${DESC[$1]}" "$C_OFF"; }

# The local copy is probed only when the served state can't stand for it: text routed to
# another machine, or the router down (then every routed app reads down).
needs_local_probe() { [[ -n ${LOCAL_PROBE[$1]:-} ]] && { ! serves_local "$1" || [[ ${UP[router]:-0} == 0 ]]; }; }

cmd_status() {
  [[ ${1:-} == --json ]] && { status_json; return; }
  [[ -z ${1:-} ]] || { echo "usage: stack status [--json]"; return 1; }
  probe_all "${BACKENDS[@]}" "${FRONTENDS[@]}" "${CONTROL[@]}"
  if have_svc; then
    if svc_enabled; then echo "AI backend switch: ${C_GREEN}ON${C_OFF}  (auto-starts at boot)"
    else                 echo "AI backend switch: ${C_RED}OFF${C_OFF} (gaming mode — won't start at boot)"; fi
  fi
  DESC[router]="Routes text → $(route_name)"
  local a
  echo "${C_B}Backends${C_OFF} (network: $NET)"
  for a in "${BACKENDS[@]}"; do
    row "$a"
    needs_local_probe "$a" && printf "  %-16s %blocal copy: %s%b\n" "" "$C_DIM" "$(local_state "$a")" "$C_OFF"
  done
  echo "${C_B}Frontends${C_OFF}";               for a in "${FRONTENDS[@]}"; do row "$a"; done
  echo "${C_B}Control${C_OFF}";                 for a in "${CONTROL[@]}"; do row "$a"; done
}

# Machine-readable status for stack-ui and scripts. Only the JSON goes to stdout. Shape:
#   { "version": 1, "switch": "on"|"off"|null,          null = no systemd unit installed
#     "route": { "text": "koboldcpp-local:5001", "where": "local"|"halo",
#                "router_config": "current"|"stale"|null },   null = router not running
#     "apps": [ { "name", "group": backend|frontend|control, "label", "capability"|null,
#                 "port", "up", "container", "description",
#                 backends:  "local": { "state": up|loading|stopped|absent|down, "probed" }
#                            (probed false = inferred from "up", no podman call made)
#                 frontends: "icon", "https_port"|null, "https_setup" } ],
#     "warnings": [ "…" ] }                              frontend.json problems
status_json() {
  command -v python3 >/dev/null 2>&1 || { echo '{"error": "python3 not found"}'; return 1; }
  local all=("${BACKENDS[@]}" "${FRONTENDS[@]}" "${CONTROL[@]}") a g sw="" cfg="" loc probed w
  local US=$'\x1f'
  probe_all "${all[@]}"
  if have_svc; then svc_enabled && sw=on || sw=off; fi
  if [[ "$(podman inspect -f '{{.State.Status}}' "${CNAME[router]}" 2>/dev/null)" == running ]]; then
    "$SELF/router/start.sh" --check && cfg=current || cfg=stale
  fi
  {
    echo "S$US$sw$US$(route_now)$US$(route_is_local && echo local || echo halo)$US$cfg"
    for a in "${all[@]}"; do
      g=backend
      [[ " ${FRONTENDS[*]} " == *" $a "* ]] && g=frontend
      [[ " ${CONTROL[*]} " == *" $a "* ]] && g=control
      loc="" probed=""
      if [[ $g == backend && $a != router ]]; then
        if needs_local_probe "$a"; then loc=$(local_state "$a"); probed=1
        else ((UP[$a])) && loc=up || loc=down; probed=0; fi
      fi
      echo "A$US$a$US$g$US${LABEL[$a]:-$a}$US${CAP[$a]:-}$US${PORT[$a]}$US${UP[$a]}$US${CNAME[$a]}$US$loc$US$probed$US${FICON[$a]:-}$US${FHTTPS[$a]:-}$US${FHTTPS_SETUP[$a]:-}$US${DESC[$a]}"
    done
    for w in "${FRONTEND_WARN[@]}"; do echo "W$US$w"; done
  } | python3 -c '
import json, sys
out = {"version": 1, "switch": None, "route": {}, "apps": [], "warnings": []}
for line in sys.stdin:
    f = line.rstrip("\n").split("\x1f")
    if f[0] == "S":
        out["switch"] = f[1] or None
        out["route"] = {"text": f[2], "where": f[3], "router_config": f[4] or None}
    elif f[0] == "A":
        name, group, label, cap, port, up, cname, loc, probed, icon, https, setup, desc = f[1:14]
        app = {"name": name, "group": group, "label": label, "capability": cap or None,
               "port": int(port), "up": up == "1", "container": cname, "description": desc}
        if loc:
            app["local"] = {"state": loc, "probed": probed == "1"}
        if group == "frontend":
            app.update(icon=icon, https_port=int(https) if https else None, https_setup=setup)
        out["apps"].append(app)
    elif f[0] == "W":
        out["warnings"].append(f[1])
print(json.dumps(out))
'
}

start_one() {
  local a=$1
  # Reached through the router, so it has to be up first (see BACKENDS).
  if [[ -n ${LOCAL_PROBE[$a]:-} ]] && ! is_up router; then start_one router || return 1; fi
  # A running router keeps the config it started with; recreate it when that has changed
  # (template, image, ports). route.conf isn't part of this: `stack route` reloads it live.
  if [[ $a == router ]] && is_up router && ! "$SELF/router/start.sh" --check; then
    echo "==> router config changed — recreating it"
    if "$SELF/router/start.sh" >/dev/null; then echo "  ${C_GREEN}✓${C_OFF} router up at http://localhost:${PORT[router]}"; return 0; fi
    echo "  ${C_RED}✗${C_OFF} router did not come back — check: stack logs router"; return 1
  fi
  if ready "$a"; then
    serves_local "$a" && echo "  $a already up (:${PORT[$a]})" || echo "  $a local copy already up"
    return 0
  fi
  # Health says down, but for a `proc` app the port may still be held — by an instance
  # that's mid-startup, or wedged. Starting now would just lose the port race, and the
  # loser's exit says nothing about the process actually serving the port. Report the
  # holder instead of launching a doomed second copy.
  if [[ "${KIND[$a]}" == proc ]]; then
    local held; held=$(port_pid "${PORT[$a]}")
    if [[ -n "$held" ]]; then
      echo "  ${C_RED}✗${C_OFF} $a: pid $held already holds :${PORT[$a]} but isn't answering health yet."
      echo "    ${C_DIM}still loading? re-run in a moment. wedged? stack down $a && stack $a${C_OFF}"
      echo "    ${C_DIM}logs: stack logs $a${C_OFF}"
      return 1
    fi
  fi
  echo "==> starting $a …"; start_app "$a"
  if wait_up "$a" "$([[ $a == koboldcpp ]] && echo 60 || echo 30)"; then
    local note=""
    [[ "${KIND[$a]}" == proc ]] && note=" ${C_DIM}(pid $(port_pid "${PORT[$a]}"))${C_OFF}"
    if serves_local "$a"; then echo "  ${C_GREEN}✓${C_OFF} $a up at http://localhost:${PORT[$a]}$note"
    else echo "  ${C_GREEN}✓${C_OFF} $a local copy up ${C_DIM}(text is routed to $(route_now); stack route local serves it)${C_OFF}"; fi
  else
    echo "  ${C_RED}✗${C_OFF} $a did not come up — check: stack logs $a"
    [[ "${KIND[$a]}" == container ]] && podman logs --tail 3 "${CNAME[$a]}" 2>&1 | sed "s/^/    ${C_DIM}/;s/\$/${C_OFF}/"
    return 1
  fi
}

# ---- backend router: where text is served ----------------------------------------------
# route.conf is nginx text the router includes; written here and only from fixed values or
# a validated host name, never from free-form input.
ROUTE_FILE="$ECO/router/route.conf"
route_now() { grep -oP 'set \$kobold_up \K[^;]+' "$ROUTE_FILE" 2>/dev/null || echo "koboldcpp-local:5001"; }
route_name() { route_is_local && echo "local" || echo "halo ($(route_now | cut -d: -f1))"; }
halo_host() {   # HALO_HOST from ai-stack/halo.env (git-ignored), parsed, never sourced
  local v; v=$(grep -oP '^HALO_HOST=\K.*' "$SELF/halo.env" 2>/dev/null | tr -d "\"'" | head -1)
  [[ "$v" =~ ^[A-Za-z0-9.-]+$ ]] && echo "$v"
}
cmd_route() {
  local t=${1:-} k
  case "$t" in
    "")    echo "text → $(route_now)"; return 0 ;;
    local) k="koboldcpp-local:5001" ;;
    halo)  local h; h=$(halo_host) || { echo "no valid HALO_HOST in $SELF/halo.env (HALO_PLAN.md Phase 2)"; return 1; }
           k="$h:5001" ;;
    *)     echo "usage: stack route [local|halo]"; return 1 ;;
  esac
  mkdir -p "$(dirname "$ROUTE_FILE")"
  printf 'set $kobold_up %s;\n' "$k" > "$ROUTE_FILE.tmp" && mv "$ROUTE_FILE.tmp" "$ROUTE_FILE"
  if podman container exists "${CNAME[router]}" 2>/dev/null \
     && [[ "$(podman inspect -f '{{.State.Status}}' "${CNAME[router]}" 2>/dev/null)" == running ]]; then
    podman exec "${CNAME[router]}" nginx -s reload >/dev/null 2>&1 \
      || { echo "  ${C_RED}✗${C_OFF} router rejected the new route — check: stack logs router"; return 1; }
    # Reload is graceful: new workers take new requests a few hundred ms later, and replies
    # already streaming finish on the old route. Return once the new route is live.
    local i
    for i in $(seq 1 20); do
      curl -sf -m 1 "http://localhost:${PORT[router]}/__router/route" 2>/dev/null | grep -qF "text $k" && break
      sleep 0.25
    done
  fi
  echo "  ${C_GREEN}✓${C_OFF} text → $k"
}

# Backends `stack up` brings up. The local text model is skipped while text is routed to
# another machine: loading it would take the GPU for a copy nothing is sent to. An explicit
# `stack koboldcpp` (or restart) still loads it.
backend_wanted() {
  if [[ $1 == koboldcpp ]] && ! route_is_local; then
    echo "  koboldcpp: text is routed to $(route_now) — local copy not loaded ${C_DIM}(stack koboldcpp loads it)${C_OFF}"
    return 1
  fi
}

# Every backend is attempted, and every failure reported: the exit status says whether
# ALL of them came up (systemd and stack-ui read it), not just the last one.
cmd_up() {
  ensure_net
  local a failed=()
  for a in "${BACKENDS[@]}"; do
    backend_wanted "$a" || continue
    start_one "$a" || failed+=("$a")
  done
  ((${#failed[@]} == 0)) && return 0
  echo "  ${C_RED}✗${C_OFF} not up: ${failed[*]}"; return 1
}

# Backends stop in reverse start order, so the router goes last: while text is still
# being served it keeps answering, rather than 502ing in front of a model being stopped.
backends_reversed() { local i; for ((i=${#BACKENDS[@]}-1; i>=0; i--)); do echo "${BACKENDS[$i]}"; done; }

cmd_restart() {
  local a=${1:?usage: stack restart <app>}
  [[ -n "${KIND[$a]:-}" ]] || { echo "unknown app: $a (try: stack status)"; return 1; }
  ensure_net
  if [[ $a == router ]]; then
    # No stop first: start.sh replaces the container itself, after checking the port, so
    # text is unreachable for the moment of the swap rather than for a stop + start.
    echo "==> restarting router …"
    if "$SELF/router/start.sh" >/dev/null; then echo "  ${C_GREEN}✓${C_OFF} router up at http://localhost:${PORT[router]}"; return 0; fi
    echo "  ${C_RED}✗${C_OFF} router did not come back — check: stack logs router"; return 1
  fi
  stop_app "$a"; sleep 1; start_one "$a"
}

cmd_down() {
  local t=${1:-all} list=() rev
  mapfile -t rev < <(backends_reversed)
  case "$t" in
    all)       list=("${FRONTENDS[@]}" "${rev[@]}") ;;
    backends)  list=("${rev[@]}") ;;
    frontends) list=("${FRONTENDS[@]}") ;;
    *)         [[ -n "${KIND[$t]:-}" ]] && list=("$t") || { echo "unknown target: $t"; return 1; } ;;
  esac
  for a in "${list[@]}"; do echo "==> stopping $a"; stop_app "$a"; done
}

have_svc()     { systemctl --user list-unit-files "$SVC" >/dev/null 2>&1; }
svc_enabled()  { systemctl --user is-enabled "$SVC" 2>/dev/null | grep -qx enabled; }

cmd_on() {
  ensure_net
  if have_svc; then
    systemctl --user enable --now "$SVC" >/dev/null 2>&1
    echo "${C_GREEN}AI backend ON${C_OFF} — running + will start at boot."
  else
    echo "(systemd unit not installed — starting backends without boot toggle)"; cmd_up
  fi
}

cmd_off() {
  if have_svc; then
    # disable --now: stop the service (ExecStop = 'stack down backends') AND remove boot start.
    systemctl --user disable --now "$SVC" >/dev/null 2>&1
  fi
  cmd_down backends >/dev/null 2>&1   # belt-and-suspenders: ensure they're really down
  echo "${C_RED}AI backend OFF${C_OFF} — stopped and will NOT restart at boot.$([ "$HOST_GPU" = nvidia ] && echo " GPU free to game.")"
  echo "  re-enable with: stack on"
}

cmd_menu() {
  echo "${C_B}ai-stack${C_OFF}"; echo
  cmd_status; echo
  # ensure backends
  local need=()
  for a in "${BACKENDS[@]}"; do is_up "$a" || { backend_wanted "$a" && need+=("$a"); }; done
  if ((${#need[@]})); then
    read -rp "Start backends (${need[*]})? [Y/n] " ans
    [[ "${ans:-Y}" =~ ^[Nn] ]] || { ensure_net; for a in "${need[@]}"; do start_one "$a"; done; echo; }
  fi
  # pick a frontend
  echo "Pick a frontend to launch:"
  ((${#FRONTENDS[@]})) || { echo "  (none installed — clone a frontend repo next to ai-stack)"; return; }
  local i=1; for a in "${FRONTENDS[@]}"; do printf "  %d) %-16s %s\n" "$i" "$a" "${DESC[$a]}"; ((i++)); done
  printf "  0) done\n"
  read -rp "> " sel
  [[ "$sel" =~ ^[0-9]+$ ]] || { echo "cancelled"; return; }
  ((sel==0)) && return
  local pick="${FRONTENDS[$((sel-1))]:-}"
  [[ -n "$pick" ]] && start_one "$pick" || echo "invalid choice"
}

cmd_logs() {
  local a=${1:?usage: stack logs <app>}
  podman logs -f "${CNAME[$a]:-$a}"
}

# ---------- install ------------------------------------------------------------
# Executable form of koboldcpp/INSTALL.md + comfyui/INSTALL.md, so the docs and the
# real thing can't drift. Everything here is idempotent: re-running reports what is
# already in place and does nothing. Model weights are never downloaded — they're
# third-party and ~73 GB; install only tells you what's missing.

IMG_KOBOLD="$(kobold_image)"     # :latest (CUDA), :vulkan or :rocm — lib/host.sh
IMG_COMFY="$(comfy_image)"       # :latest (CUDA) or :rocm
IMG_FORTUNA="$(fortuna_image)"   # :vulkan, :cuda or :rocm — llama.cpp base pinned in lib/host.sh
IMG_STACKUI="localhost/stackui:latest"
# Stock nginx, pinned in router/start.sh; read from there so the two can't disagree.
IMG_ROUTER="$(grep -oP '^IMAGE="\K[^"]+' "$SELF/router/start.sh" 2>/dev/null)"

# ComfyUI custom nodes the frontends depend on. Cloned into the bind-mounted
# custom_nodes/ state dir, pinned to a commit so a rebuild can't silently pull in
# upstream changes.
#
# IMPORTANT: a node's Python dependencies do NOT belong here. custom_nodes/ is
# state, but the container is recreated on every start, so runtime pip installs
# evaporate. Deps go in comfyui/Containerfile — adding a row here usually means
# adding a line there too. Weights are never downloaded (see the note in
# cmd_install); missing ones are reported, not fetched.
#
# An optional 4th field names a patch in comfyui/patches/, applied to the working tree
# after checkout (HEAD stays on the pin). For upstream fixes we need but can't push;
# each patch's header says why. `git apply --reverse --check` tells applied from not.
#
#            name|repo|pinned commit[|patch]
CUSTOM_NODES=(
  "ComfyUI-GGUF|https://github.com/city96/ComfyUI-GGUF.git|6ea2651e7df66d7585f6ffee804b20e92fb38b8a"
  "ComfyUI_PuLID_Flux_ll|https://github.com/lldacing/ComfyUI_PuLID_Flux_ll.git|7c7362b806c2c0f4bde8742ada9e7cb05b44d249|ComfyUI_PuLID_Flux_ll.patch"
)

WARNS=0
ok()   { echo "  ${C_GREEN}✓${C_OFF} $*"; }
warn() { WARNS=$((WARNS+1)); echo "  ${C_RED}!${C_OFF} $*"; }
step() { echo "==> $*"; }

check_prereqs() {
  local bad=0
  command -v podman >/dev/null 2>&1 && ok "podman $(podman --version | awk '{print $3}')" \
    || { warn "podman not found — required"; bad=1; }
  if [ -n "${HOST_PROFILE_BAD:-}" ]; then
    warn "host.env is invalid (see the message above) — fix $HOST_ENV_FILE"; return 1
  fi
  ok "host profile: GPU ${HOST_GPU}, LLM runtime ${HOST_LLM_BACKEND}$([ -n "$HOST_BIND" ] && echo ", ports on $HOST_BIND only")$([ -f "$HOST_ENV_FILE" ] || echo " (detected; no host.env)")"
  case "$HOST_GPU" in
    nvidia) check_gpu_nvidia || bad=1 ;;
    amd)    check_gpu_amd || bad=1 ;;
    *)      warn "no GPU found (no NVIDIA CDI spec, no /dev/kfd) — the backends would run on the CPU"; bad=1 ;;
  esac
  return $bad
}

check_gpu_nvidia() {
  local bad=0
  if nvidia-smi >/dev/null 2>&1; then
    ok "nvidia driver: $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader | head -1)"
  else
    warn "nvidia-smi failed on the host — GPU passthrough will not work"; bad=1
  fi
  if nvidia-ctk cdi list 2>/dev/null | grep -q "nvidia.com/gpu=all"; then
    ok "CDI device nvidia.com/gpu=all present"
  else
    warn "no CDI spec — run: sudo nvidia-ctk cdi generate --output=/etc/cdi/nvidia.yaml"; bad=1
  fi
  return $bad
}

# The AMD box (HALO_PLAN.md): device nodes and group access, a kernel new enough for
# gfx1151, and how much of the unified memory the GPU may use.
check_gpu_amd() {
  local bad=0 k major minor patch g limit
  [ -e /dev/kfd ] && ok "/dev/kfd present (ROCm compute)" || { warn "/dev/kfd missing — amdgpu/KFD not loaded"; bad=1; }
  compgen -G "/dev/dri/renderD*" >/dev/null && ok "render node $(ls /dev/dri/renderD* | head -1)" \
    || { warn "no /dev/dri/renderD* — no GPU render node"; bad=1; }
  for g in render video; do
    if id -nG | tr ' ' '\n' | grep -qx "$g"; then ok "user in group $g"
    else warn "user not in group $g — run: sudo usermod -aG $g $USER (then log in again)"; bad=1; fi
  done
  # Community reports: gfx1151 is unstable under ROCm before 6.18.4 (HALO_PLAN.md).
  k="$(uname -r)"; IFS=. read -r major minor patch <<<"${k%%[-+]*}"
  if (( major > 6 || (major == 6 && (minor > 18 || (minor == 18 && ${patch:-0} >= 4))) )); then
    ok "kernel $k (>= 6.18.4)"
  else
    warn "kernel $k is older than 6.18.4 — reported unstable for gfx1151 under ROCm"; bad=1
  fi
  # ttm.pages_limit is in 4 KiB pages; unset means the kernel default (about half of RAM).
  limit="$(cat /sys/module/ttm/parameters/pages_limit 2>/dev/null || true)"
  if [ -n "$limit" ] && [ "$limit" != 0 ]; then
    ok "GPU may use up to $(( limit * 4 / 1024 / 1024 )) GiB (ttm.pages_limit)"
  else
    warn "ttm.pages_limit not set — ROCm sees about half the memory (HALO_PLAN.md: kernel parameters)"
  fi
  return $bad
}

install_path() {
  local target="$HOME/.local/bin/stack" src; src="$(readlink -f "${BASH_SOURCE[0]}")"
  if [ -e "$target" ] && [ "$(readlink -f "$target")" = "$src" ]; then
    ok "on PATH at $target"
  else
    step "linking $target -> $src"
    mkdir -p "$HOME/.local/bin" && ln -sfn "$src" "$target" && ok "linked"
    case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) warn "$HOME/.local/bin is not on your PATH" ;; esac
  fi
}

# The shipped unit is a template: @SELF@ becomes this checkout's path, so the unit
# points at the stack wherever it was cloned. It used to hardcode
# ~/Development/ai_ecosystem/ai-stack — the one place the "clone anywhere" promise
# broke, and silently: `stack on` enables a unit whose ExecStart doesn't exist.
render_unit() { sed "s|@SELF@|$SELF|g" "$SELF/$SVC"; }

install_service() {
  local dst="$HOME/.config/systemd/user/$SVC" rendered
  rendered=$(render_unit)
  # COPY, never symlink: `systemctl disable` deletes a symlinked unit, which then
  # breaks `stack on`.
  if [ -f "$dst" ] && [ "$rendered" = "$(cat "$dst")" ]; then
    ok "systemd unit installed ($dst)"
  else
    step "installing systemd unit -> $dst"
    mkdir -p "$(dirname "$dst")" && printf '%s\n' "$rendered" > "$dst" \
      && systemctl --user daemon-reload && ok "installed"
  fi
  [ "$(loginctl show-user "$USER" -p Linger --value 2>/dev/null)" = "yes" ] \
    && ok "linger enabled (backends can start before login)" \
    || warn "linger off — run: loginctl enable-linger"
  svc_enabled && ok "boot auto-start armed (stack on)" || echo "  ${C_DIM}boot auto-start off — arm with: stack on${C_OFF}"
}

# The koboldcpp recipe is canonical in this checkout, but it has to *run* from
# $ECO/koboldcpp: start.sh resolves models/ next to itself, and models/ (~15 GB) has to
# stay out of the repo. So that directory is a symlink farm back into the checkout plus
# a real models/ — the shape koboldcpp/INSTALL.md §1 describes. Building it here is what
# makes a fresh clone installable; before this it was a hand-made thing that existed on
# exactly one machine, and `stack install koboldcpp` just reported "build failed".
# Symlinks, not copies: a copy is free to drift from the published recipe.
link_koboldcpp_recipe() {
  local dir="$ECO/koboldcpp" src="$SELF/koboldcpp" f n=0
  # AI_ECOSYSTEM could point at the checkout itself; then the recipe is already in place.
  [ "$(readlink -f "$dir")" = "$(readlink -f "$src")" ] && { ok "recipe in place ($dir)"; return 0; }
  mkdir -p "$dir/models"
  # .containerignore is the one file that must be a REAL copy: podman does not follow a
  # symlinked ignore file — it behaves exactly as if none were there (verified against
  # podman 5.8), so the build would tar the whole ~15 GB models/ tree, which is the
  # trap koboldcpp/INSTALL.md §1 warns about. It's our file, not user data, so a stale
  # or symlinked one is refreshed rather than left alone — that's what keeps it from
  # drifting the way the other four can't.
  if [ -L "$dir/.containerignore" ] || ! cmp -s "$src/.containerignore" "$dir/.containerignore"; then
    rm -f "$dir/.containerignore"
    cp "$src/.containerignore" "$dir/.containerignore" \
      && ok "copied .containerignore (podman ignores a symlinked one)"
  fi
  for f in Containerfile start.sh chatml.json mistral-nemo.json CLAUDE.md; do
    if [ -e "$dir/$f" ]; then
      # Resolved targets, not literal ones: the existing farm uses relative links,
      # which are just as correct as the absolute ones made here.
      [ "$(readlink -f "$dir/$f")" = "$(readlink -f "$src/$f")" ] && continue
      warn "koboldcpp/$f is not the repo copy — left alone ($dir/$f)"
    else
      ln -s "$src/$f" "$dir/$f" && n=$((n+1))
    fi
  done
  ((n)) && ok "linked $n recipe file(s) into $dir" || ok "recipe linked at $dir"
}

install_router() {
  step "router"
  if [ -z "$IMG_ROUTER" ]; then
    warn "no IMAGE= line in $SELF/router/start.sh"; return 1
  elif podman image exists "$IMG_ROUTER"; then
    ok "image $IMG_ROUTER present"
  else
    # Pulled now rather than at the first `stack up`, which runs at boot, possibly offline.
    echo "  pulling $IMG_ROUTER …"
    podman pull -q "$IMG_ROUTER" >/dev/null || { warn "pull failed"; return 1; }
    ok "image pulled"
  fi
}

install_koboldcpp() {
  step "koboldcpp"
  link_koboldcpp_recipe
  if podman image exists "$IMG_KOBOLD"; then
    ok "image $IMG_KOBOLD built"
  else
    echo "  building $(kobold_containerfile) for ${HOST_LLM_BACKEND} (a few minutes; ROCm compiles from source, much longer)…"
    podman build --format docker -t "$IMG_KOBOLD" -f "$SELF/koboldcpp/$(kobold_containerfile)" "$ECO/koboldcpp" \
      || { warn "build failed"; return 1; }
    ok "image built"
  fi
  local models="$ECO/koboldcpp/models" n=0   # created by link_koboldcpp_recipe
  n=$(find "$models" -maxdepth 1 -name '*.gguf' 2>/dev/null | wc -l)
  ((n)) && ok "$n GGUF model(s) in $models" \
        || warn "no *.gguf in $models — see ai-stack/koboldcpp/INSTALL.md §2"
}

# 0 = the node's patch is applied (or it has none), 1 = not applied, 2 = doesn't fit.
node_patch_state() {
  local dir=$1 patch=$2
  [ -n "$patch" ] || return 0
  git -C "$dir" apply --reverse --check "$SELF/comfyui/patches/$patch" 2>/dev/null && return 0
  git -C "$dir" apply --check "$SELF/comfyui/patches/$patch" 2>/dev/null && return 1
  return 2
}

apply_node_patch() {
  local name=$1 dir=$2 patch=$3 st=0
  node_patch_state "$dir" "$patch" || st=$?
  case $st in
    0) [ -z "$patch" ] || ok "custom node $name: $patch applied" ;;
    1) git -C "$dir" apply "$SELF/comfyui/patches/$patch" \
         && ok "custom node $name: applied $patch" \
         || warn "custom node $name: applying $patch failed" ;;
    *) warn "custom node $name: $patch doesn't apply to this checkout — local edits?" ;;
  esac
}

install_custom_nodes() {
  local state=$1 row name url pin patch dir have
  ((${#CUSTOM_NODES[@]})) || return 0
  if ! command -v git >/dev/null 2>&1; then
    warn "git not found — cannot install custom nodes"; return 0
  fi
  for row in "${CUSTOM_NODES[@]}"; do
    IFS='|' read -r name url pin patch <<<"$row"
    dir="$state/custom_nodes/$name"
    if [ -d "$dir/.git" ]; then
      have=$(git -C "$dir" rev-parse HEAD 2>/dev/null)
      if [ "$have" = "$pin" ]; then
        ok "custom node $name @ ${pin:0:7}"
      else
        step "custom node $name: ${have:0:7} -> ${pin:0:7}"
        # Not --depth 1 anywhere in here: a shallow clone only carries the tip, so
        # checking out an older pin would fail the moment upstream moves on.
        git -C "$dir" fetch --quiet origin 2>/dev/null
        if git -C "$dir" checkout --quiet "$pin" 2>/dev/null; then
          ok "custom node $name @ ${pin:0:7}"
        else
          warn "custom node $name: commit $pin not found in $dir"
        fi
      fi
      apply_node_patch "$name" "$dir" "$patch"
    elif [ -e "$dir" ]; then
      warn "custom node $name exists but isn't a git checkout — left alone ($dir)"
    else
      step "cloning custom node $name"
      if git clone --quiet "$url" "$dir" 2>/dev/null \
         && git -C "$dir" checkout --quiet "$pin" 2>/dev/null; then
        ok "custom node $name @ ${pin:0:7}"
        apply_node_patch "$name" "$dir" "$patch"
      else
        warn "custom node $name: clone failed — $url"
      fi
    fi
  done
}

install_comfyui() {
  step "comfyui"
  if podman image exists "$IMG_COMFY"; then
    ok "image $IMG_COMFY built"
  else
    echo "  building $(comfy_containerfile) (torch + GPU wheels, several GB; several minutes)…"
    podman build --format docker -t "$IMG_COMFY" -f "$SELF/comfyui/$(comfy_containerfile)" "$SELF/comfyui" \
      || { warn "build failed"; return 1; }
    ok "image built"
  fi
  # Code ships in the image; the host tree only holds state. Create the skeleton so a
  # fresh install can start before any models are downloaded.
  local state="${COMFYUI_STATE:-$ECO/ComfyUI}" d
  for d in models/checkpoints input output user custom_nodes; do mkdir -p "$state/$d"; done
  ok "state dirs ready under $state"
  local n; n=$(find "$state/models/checkpoints" -maxdepth 1 -type f \
                    \( -name '*.safetensors' -o -name '*.ckpt' \) 2>/dev/null | wc -l)
  ((n)) && ok "$n checkpoint(s) in $state/models/checkpoints" \
        || warn "no checkpoints — see ai-stack/comfyui/INSTALL.md §8 (start with absolutereality_v181)"

  install_custom_nodes "$state"

  # PhotoMaker-Plus is inert without its weights, and weights are out of scope —
  # so say what's missing rather than pretending the node is ready to use.
  if [ -d "$state/custom_nodes/ComfyUI-PhotoMaker-Plus" ]; then
    n=$(find "$state/models/photomaker" -maxdepth 1 -name '*.bin' 2>/dev/null | wc -l)
    ((n)) && ok "$n PhotoMaker model(s) in $state/models/photomaker" \
          || warn "no PhotoMaker weights — put photomaker-v{1,2}.bin in $state/models/photomaker"
    # insightface resolves buffalo_l as <root>/models/<name>, hence the doubled path.
    [ -f "$state/models/insightface/models/buffalo_l/det_10g.onnx" ] \
      && ok "InsightFace buffalo_l present" \
      || warn "no InsightFace buffalo_l — needs the 5 .onnx files in $state/models/insightface/models/buffalo_l/ (PhotoMaker V2 only)"
  fi
}

install_fortuna() {
  step "fortuna"
  if podman image exists "$IMG_FORTUNA"; then
    ok "image $IMG_FORTUNA built"
  else
    echo "  building on llama.cpp ${HOST_LLM_BACKEND} b11146 (pulls the base image the first time)…"
    podman build --format docker --build-arg "BASE=$(fortuna_base_image)" -t "$IMG_FORTUNA" "$SELF/fortuna" \
      || { warn "build failed"; return 1; }
    ok "image built"
  fi
  # Weights are never fetched here (see above); the recipe has an explicit, hash-checked fetch.
  local models="${FORTUNA_STATE:-$ECO/fortuna}/models" n
  mkdir -p "$models"
  n=$(find "$models" -maxdepth 1 -name '*.gguf' 2>/dev/null | wc -l)
  ((n)) && ok "$n GGUF model(s) in $models" \
        || warn "no Fortuna model — fetch it (4.5 GB, sha256-checked): ai-stack/fortuna/start.sh --fetch"
}

install_stackui() {
  step "stack-ui"
  if podman image exists "$IMG_STACKUI"; then
    ok "image $IMG_STACKUI built"
  else
    echo "  building (python + podman client; ~1 minute)…"
    podman build --format docker -t "$IMG_STACKUI" "$SELF/stack-ui" || { warn "build failed"; return 1; }
    ok "image built"
  fi
  # It drives the host engine through this socket, so without it the dashboard builds
  # fine and then can't do anything. Not enabled for you: it's your session config, the
  # same reason linger is a warning rather than an action.
  if systemctl --user is-active podman.socket >/dev/null 2>&1; then
    ok "podman.socket active (stack-ui reaches the host engine through it)"
  else
    warn "podman.socket inactive — run: systemctl --user enable --now podman.socket"
  fi
}

cmd_install() {
  local t=${1:-all} rc=0
  case "$t" in all|backends|router|koboldcpp|comfyui|fortuna|stackui|service|path) ;;
    *) echo "unknown install target: $t (all|backends|router|koboldcpp|comfyui|fortuna|stackui|service|path)"; return 1 ;;
  esac
  echo "${C_B}ai-stack install${C_OFF} — target: $t   ${C_DIM}(idempotent; weights are never downloaded)${C_OFF}"
  echo "${C_B}Prerequisites${C_OFF}"; check_prereqs || rc=1
  [[ "$t" == all || "$t" == path ]]    && { echo "${C_B}PATH${C_OFF}";    install_path; }
  [[ "$t" == all || "$t" == service ]] && { echo "${C_B}systemd${C_OFF}"; install_service; }
  if [[ "$t" == router ]]; then echo "${C_B}Backends${C_OFF}"; ensure_net; install_router || rc=1; fi
  if [[ "$t" == all || "$t" == backends || "$t" == koboldcpp || "$t" == comfyui ]]; then
    echo "${C_B}Backends${C_OFF}"; ensure_net
    [[ "$t" == all || "$t" == backends ]] && { install_router || rc=1; }
    [[ "$t" == comfyui   ]] || install_koboldcpp || rc=1
    [[ "$t" == koboldcpp ]] || install_comfyui   || rc=1
  fi
  if [[ "$t" == all || "$t" == backends || "$t" == fortuna ]]; then
    [[ "$t" == fortuna ]] && { echo "${C_B}Backends${C_OFF}"; ensure_net; }
    install_fortuna || rc=1
  fi
  if [[ "$t" == all || "$t" == stackui ]]; then
    echo "${C_B}AI Ecosystem${C_OFF}"; install_stackui || rc=1
  fi
  echo
  # Missing weights are not an install failure — they're deliberately out of scope —
  # but "complete" would be a lie when nothing can actually start. Say which it is.
  if ((rc)); then
    echo "${C_RED}install failed${C_OFF} — unmet prerequisites above"
  elif ((WARNS)); then
    echo "${C_RED}install done, $WARNS item(s) need you${C_OFF} — the stack won't start until they're resolved"
  else
    echo "${C_GREEN}install complete${C_OFF} — start with: stack on"
  fi
  ((rc)) && return 1 || return 0
}

cmd_doctor() {
  echo "${C_B}Prerequisites${C_OFF}"; check_prereqs
  echo "${C_B}Installed${C_OFF}"
  podman image exists "$IMG_KOBOLD" && ok "$IMG_KOBOLD" || warn "$IMG_KOBOLD missing — stack install koboldcpp"
  podman image exists "$IMG_COMFY"  && ok "$IMG_COMFY"  || warn "$IMG_COMFY missing — stack install comfyui"
  podman image exists "$IMG_FORTUNA" && ok "$IMG_FORTUNA" || warn "$IMG_FORTUNA missing — stack install fortuna"
  podman image exists "$IMG_STACKUI" && ok "$IMG_STACKUI" || warn "$IMG_STACKUI missing — stack install stackui"
  [ -n "$IMG_ROUTER" ] && podman image exists "$IMG_ROUTER" && ok "$IMG_ROUTER" \
    || warn "${IMG_ROUTER:-router image} missing — stack install router"
  podman network exists "$NET" 2>/dev/null && ok "network $NET" || warn "network $NET missing — stack install"
  if [ ! -x "$ECO/koboldcpp/start.sh" ]; then
    warn "no $ECO/koboldcpp/start.sh — stack install koboldcpp"
  elif [ -L "$ECO/koboldcpp/.containerignore" ] || [ ! -f "$ECO/koboldcpp/.containerignore" ]; then
    # Silent when wrong: the build still succeeds, it just tars models/ first.
    warn "koboldcpp/.containerignore missing or symlinked (podman ignores it; a rebuild would tar models/) — stack install koboldcpp"
  else
    ok "koboldcpp recipe at $ECO/koboldcpp"
  fi
  # An installed unit isn't enough: one rendered for a different checkout enables fine
  # and then fails at boot, and an older one can carry a start timeout too short for a
  # cold model load. So the whole installed file is compared with what install would write.
  local unit="$HOME/.config/systemd/user/$SVC"
  if [ ! -f "$unit" ]; then
    warn "$SVC not installed — stack install service"
  elif [ "$(render_unit)" = "$(cat "$unit")" ]; then
    ok "systemd unit $SVC"
  elif ! grep -qF "ExecStart=$SELF/stack" "$unit"; then
    warn "$SVC points at another path, not $SELF — stack install service"
  else
    warn "$SVC is out of date with this checkout — stack install service"
  fi
  local state="${COMFYUI_STATE:-$ECO/ComfyUI}" row name pin patch dir
  for row in "${CUSTOM_NODES[@]}"; do
    IFS='|' read -r name _ pin patch <<<"$row"
    dir="$state/custom_nodes/$name"
    if [ ! -d "$dir/.git" ]; then
      warn "custom node $name missing — stack install comfyui"
    elif [ "$(git -C "$dir" rev-parse HEAD 2>/dev/null)" = "$pin" ]; then
      if node_patch_state "$dir" "$patch"; then
        ok "custom node $name @ ${pin:0:7}${patch:+ + $patch}"
      else
        warn "custom node $name: $patch not applied — stack install comfyui"
      fi
    else
      warn "custom node $name off its pin (${pin:0:7}) — stack install comfyui"
    fi
  done
  echo "${C_B}Frontends${C_OFF} ${C_DIM}(repos in $ECO with a frontend.json)${C_OFF}"
  local f
  ((${#FRONTENDS[@]})) || warn "no frontends installed — clone one next to ai-stack"
  for f in "${FRONTENDS[@]}"; do ok "$f (${LABEL[$f]}) at ${FDIR[$f]}"; done
  for f in "${FRONTEND_WARN[@]}"; do warn "$f"; done
  echo "${C_B}Runtime${C_OFF}"; cmd_status
}

case "${1:-}" in
  ""|menu)   cmd_menu ;;
  on|enable)  cmd_on ;;
  off|disable|gaming) cmd_off ;;
  up|backends) cmd_up ;;
  status|st) cmd_status "${2:-}" ;;
  down)      cmd_down "${2:-all}" ;;
  restart)   cmd_restart "${2:-}" ;;
  logs)      cmd_logs "${2:-}" ;;
  route)     cmd_route "${2:-}" ;;
  install|setup) cmd_install "${2:-all}" ;;
  doctor|check)  cmd_doctor ;;
  frontends) cmd_frontends "${2:-}" ;;
  # Print the header block by finding its closing rule rather than a fixed line
  # number -- the hardcoded 2,22 silently truncated the last lines of help as
  # soon as a command was added.
  -h|--help|help) awk 'NR>2 && /^# =+$/{exit} NR>=2' "$0" | sed 's/^# \{0,1\}//' ;;
  *)         a=$1; [[ -n "${KIND[$a]:-}" ]] || { echo "unknown app: $a (try: stack status)"; exit 1; }
             [[ " ${FRONTENDS[*]} " == *" $a "* ]] && ensure_net
             start_one "$a" ;;
esac
