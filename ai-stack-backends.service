# Template — install it with `stack install service`, not `cp`.
# @SELF@ is substituted with the ai-stack checkout's own path at install time, so the
# unit works wherever the stack is cloned. systemd rejects the placeholder as-is, so a
# stray manual copy fails loudly instead of pointing at a path that doesn't exist.
[Unit]
Description=AI stack backends (router, text, image and sound, decisions)
Documentation=file:@SELF@/CLAUDE.md
After=default.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Reuses the stack's own start logic (each backend's start.sh, router first).
# 900 s: a cold start loads the text model, ComfyUI and Fortuna one after another, and
# KoboldCPP alone may wait up to 300 s plus out-of-memory retries.
ExecStart=@SELF@/stack up
ExecStop=@SELF@/stack down backends
TimeoutStartSec=900

[Install]
WantedBy=default.target
