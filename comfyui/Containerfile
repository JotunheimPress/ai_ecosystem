# ComfyUI — containerized backend for the ai-stack.
#
# Code lives in the image (cloned at a pinned tag); mutable state (models, input,
# output, user, custom_nodes) is bind-mounted from the host checkout and pointed at
# with --base-directory. Bump COMFYUI_VERSION and rebuild to upgrade.
#
# No CUDA base image needed: the cu130 torch wheels bundle the CUDA runtime, and the
# driver is injected by CDI (--device nvidia.com/gpu=all), same as koboldcpp.
ARG COMFYUI_VERSION=v0.31.1

FROM docker.io/library/ubuntu:24.04 AS base

ARG COMFYUI_VERSION
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# libgl1/libglib2.0-0t64 are pulled in by OpenCV via several ComfyUI deps; without
# them you get an import error at startup rather than at install time.
RUN apt-get update && apt-get install -y --no-install-recommends \
        git \
        ca-certificates \
        python3 \
        python3-venv \
        libgl1 \
        libglib2.0-0t64 \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 --branch "${COMFYUI_VERSION}" \
        https://github.com/comfyanonymous/ComfyUI.git /opt/ComfyUI

WORKDIR /opt/ComfyUI

# torch FIRST, from the CUDA 13.0 index — the default PyPI index serves a different
# build that will not match this environment.
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}"
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cu130 \
        torch==2.11.0 torchvision==0.26.0 torchaudio==2.11.0

# Then the pinned environment. Captured from the reference install; torch is already
# satisfied above (PEP 440: 2.11.0+cu130 matches ==2.11.0).
COPY requirements.lock.v0.31.1.txt /tmp/requirements.lock.txt
RUN pip install --no-cache-dir \
        --extra-index-url https://download.pytorch.org/whl/cu130 \
        -r /tmp/requirements.lock.txt \
    && rm /tmp/requirements.lock.txt

# ── Custom-node dependencies ─────────────────────────────────────────────────
# Custom nodes are bind-mounted state (/data/custom_nodes) but their Python deps
# have to live in the image, or they vanish every time the container is recreated.
#
# ComfyUI-PhotoMaker-Plus (shiimizu) — needs InsightFace for the PhotoMaker V2
# face-embedding path. Deliberately NOT installed from that node's own
# requirements.txt: it pins `numpy<2`, which was only ever needed for the old
# insightface 0.7.3 sdist, and honouring it would downgrade numpy out from under
# torch 2.11 / ComfyUI 0.31 and break the whole image.
#   - insightface >=1.0 ships a pure-Python wheel — no compiler needed in this
#     image (there is no gcc here) and it accepts numpy 2.x.
#   - onnxruntime is the CPU build on purpose. Face detection runs once per job on
#     the small buffalo_l model (~0.3 s), while onnxruntime-gpu has no build
#     matching this image's CUDA 13 torch and would drag in a conflicting CUDA
#     runtime. Pass provider="CPU" to PhotoMakerInsightFaceLoader to match.
RUN pip install --no-cache-dir \
        insightface==1.0.1 \
        onnxruntime==1.28.0

# ComfyUI-GGUF (city96) — UnetLoaderGGUF, for running Flux.1 Kontext [dev] as a
# quantized GGUF. The fp8 build needs ~20 GB VRAM; this card has 12, so GGUF is the
# only local path and the node is not optional.
#
# Only `gguf` is installed. That node's requirements.txt also lists sentencepiece
# and protobuf, but those are for its *GGUF text-encoder* path — we load clip_l and
# t5xxl as safetensors via the stock DualCLIPLoader, so they're dead weight here.
# Add them if a GGUF-quantized text encoder is ever used.
RUN pip install --no-cache-dir \
        gguf==0.19.0

EXPOSE 8188

# HEALTHCHECK is a docker-format field with no OCI slot, so podman drops it unless the build
# passes --format docker (start.sh and `stack install comfyui` both do). Without that flag
# this block is silently inert.
#
# python3 rather than curl: curl isn't in this image, and a liveness probe doesn't justify an
# apt layer for it. /opt/venv/bin/python3 is first on PATH (set above) and urllib is stdlib.
#
# The long start period covers importing torch and loading custom nodes — insightface and the
# GGUF node included — which takes far longer than an ordinary web app's boot. Failures inside
# the period don't count. /system_stats is what `stack status` already probes.
HEALTHCHECK --interval=30s --timeout=10s --start-period=300s --retries=3 \
    CMD python3 -c "import urllib.request; urllib.request.urlopen('http://localhost:8188/system_stats', timeout=8)" || exit 1

ENTRYPOINT ["/opt/venv/bin/python3", "main.py"]
CMD ["--listen", "0.0.0.0", "--port", "8188", "--base-directory", "/data"]
