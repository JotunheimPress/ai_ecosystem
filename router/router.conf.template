# Backend router: answers as `koboldcpp` on ai-net (and on the host port that container used
# to publish) and forwards each request to wherever text runs right now: the local copy, or
# the Halo box (HALO_PLAN.md). Frontends keep their URLs and never learn which machine answered.
#
# Rendered by the nginx image's own entrypoint: only ${NGINX_LOCAL_RESOLVERS} is substituted
# (envsubst is limited to variables that exist in the environment), so nginx's own $vars
# pass through untouched.

# Upstreams are VARIABLES resolved per request through aardvark-dns, not static `upstream`
# blocks. A static name has to resolve when nginx starts, and the local containers are
# often absent (started on demand), so a static config would refuse to start at all.
# valid=5s: a restarted container comes back with a new IP.
resolver ${NGINX_LOCAL_RESOLVERS} valid=5s ipv6=off;

# Long generations and streamed replies (SSE). Buffering would hold a streamed reply until
# it finished, which is the whole point of streaming lost.
proxy_http_version 1.1;
proxy_set_header Connection "";
proxy_set_header Host $host;
proxy_buffering off;
proxy_request_buffering off;
proxy_read_timeout 1h;
proxy_send_timeout 1h;
proxy_connect_timeout 5s;
client_max_body_size 64m;      # KoboldCPP's own --maxrequestsize default is 32 MB
access_log off;                # health polls every few seconds; errors still go to the log

# Text: KoboldCPP
server {
    listen 5001;
    include /etc/nginx/route/route.conf;     # sets $kobold_up (written by `stack route`)

    location = /__router/health { default_type text/plain; return 200 "ok\n"; }
    location = /__router/route  { default_type text/plain; return 200 "text $kobold_up\n"; }
    location / { proxy_pass http://$kobold_up; }
}
